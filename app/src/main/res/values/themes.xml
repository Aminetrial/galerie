<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0F1115</color>
    <color name="black">#FF000000</color>
    <color name="bar">#FF171A21</color>
    <color name="accent">#FF5B9CFF</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
    </style>

    <style name="ViewerTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
